# ========================= 服务器连接 =========================
# SSH 连接目标（强烈建议填写服务器公网 IP）
SSH_HOST=
# 可选：如果你更习惯用域名作为 SSH 连接目标，可以额外填写 DOMAIN
# DOMAIN=example.com
# SSH 登录用户
SSH_USER=root
# SSH 端口（推荐 2222，避免部分网络 / 代理 / 云厂商链路对 22 端口做特殊处理）
SSH_PORT=2222

# ========================= FRP 配置 =========================
# FRP 版本（latest = 自动拉取 GitHub 最新发布）
FRP_VERSION=latest
# FRPS 监听端口（供 frpc 客户端连接）
FRPS_BIND_PORT=7000
# FRP 认证 Token（服务端与客户端必须一致，请设置强密码）
FRPS_AUTH_TOKEN=请设置一个强密码

# ========================= Caddy 说明 =========================
# Caddy 的域名、Cloudflare Token 与反代端口请直接写在本地 Caddyfile 中
# 请先复制 Caddyfile.example 为 Caddyfile，再按你的真实环境修改
