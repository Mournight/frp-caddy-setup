# ========================= 服务器连接 =========================
# SSH 登录用户
SSH_USER=root
# SSH 端口
SSH_PORT=22

# ========================= FRP 配置 =========================
# FRP 版本（latest = 自动拉取 GitHub 最新发布）
FRP_VERSION=latest
# FRPS 监听端口（供 frpc 客户端连接）
FRPS_BIND_PORT=7000
# FRP 认证 Token（服务端与客户端必须一致，请设置强密码）
FRPS_AUTH_TOKEN=请设置一个强密码

# ========================= 域名与证书 =========================
# 你的根域名（同时用于 SSH 连接和 Caddy 泛域名证书）
DOMAIN=example.com
# Cloudflare DNS API Token（用于 DNS-01 验证签发泛域名证书）
CF_DNS_TOKEN=your-cloudflare-api-token
