# ======================= Caddy 泛域名配置 =======================
# 使用 Cloudflare DNS-01 Challenge 签发泛域名证书
# 需要 Caddy 编译时包含 caddy-dns/cloudflare 插件
#
# {{DOMAIN}} 和 {{CF_DNS_TOKEN}} 会在部署时自动替换为 .env 中的值
# 请在下方添加你自己的子域名反向代理规则

*.{{DOMAIN}}, {{DOMAIN}} {
    tls {
        dns cloudflare {{CF_DNS_TOKEN}}
    }

    @git host git.{{DOMAIN}}
    handle @git {
        reverse_proxy 127.0.0.1:13000
    }

    @i host i.{{DOMAIN}} {{DOMAIN}}
    handle @i {
        reverse_proxy 127.0.0.1:12368
    }

    @arc host arc.{{DOMAIN}}
    handle @arc {
        reverse_proxy 127.0.0.1:17788
    }

    @cloud host cloud.{{DOMAIN}}
    handle @cloud {
        reverse_proxy 127.0.0.1:19966
    }

    @db host db.{{DOMAIN}}
    handle @db {
        reverse_proxy 127.0.0.1:15432
    }

    @api host api.{{DOMAIN}}
    handle @api {
        reverse_proxy 127.0.0.1:18317
    }

    @dev host dev.{{DOMAIN}}
    handle @dev {
        reverse_proxy 127.0.0.1:12345
    }

    @test host test.{{DOMAIN}}
    handle @test {
        reverse_proxy 127.0.0.1:12346
    }

    @ai host ai.{{DOMAIN}}
    handle @ai {
        reverse_proxy 127.0.0.1:17860
    }

    @file host file.{{DOMAIN}}
    handle @file {
        reverse_proxy 127.0.0.1:15212
    }

    @lui host lui.{{DOMAIN}}
    handle @lui {
        reverse_proxy 127.0.0.1:16689
    }

    # 未匹配的子域名返回 404
    handle {
        respond "Not Found" 404
    }
}
